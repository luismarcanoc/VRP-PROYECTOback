PORT=10000
DATABASE_URL=postgresql://user:password@ep-xxxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
GOOGLE_MAPS_SERVER_API_KEY=tu_clave_servidor_google_maps_routes
GOOGLE_MAPS_BROWSER_API_KEY=tu_clave_publica_google_maps_js
