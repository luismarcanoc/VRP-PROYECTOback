GOOGLE_MAPS_API_KEY=
DISTRIBUTION_ORIGIN=Planta Bello Campo, Caracas, Venezuela
FRONTEND_ORIGIN=https://tu-frontend.vercel.app
NEON_SOURCE_TABLE=DIRECCIONES Y RUTAS
AUTO_DEPLOY_ON_DB_CHANGE=false
RENDER_DEPLOY_HOOK_URL=
DB_WATCH_INTERVAL_MS=120000
AUTO_DEPLOY_COOLDOWN_MS=600000
# Opcional: query SQL personalizada que debe devolver una columna "signature"
DB_CHANGE_WATCH_QUERY=
