PORT=10000
DATABASE_URL=postgresql://usuario:password@tu-servidor:5432/tu_base?sslmode=disable
NODE_ENV=development
GOOGLE_MAPS_SERVER_API_KEY=tu_clave_servidor_google_maps_routes
GOOGLE_MAPS_BROWSER_API_KEY=tu_clave_publica_google_maps_js
# Compatibilidad: si solo defines GOOGLE_MAPS_API_KEY, el backend la usa como clave de servidor.
GOOGLE_MAPS_API_KEY=
DISTRIBUTION_ORIGIN_NAME=PDT Bello Campo
DISTRIBUTION_ORIGIN=Edificio Onnis, Avenida Francisco de Miranda, & Avenida Coromoto, Caracas 1060, Miranda, Venezuela
FRONTEND_ORIGIN=https://tu-frontend.vercel.app
SOURCE_TABLE=hojas_ruta_exportadas
AUTO_DEPLOY_ON_DB_CHANGE=false
RENDER_DEPLOY_HOOK_URL=
DB_WATCH_INTERVAL_MS=120000
AUTO_DEPLOY_COOLDOWN_MS=600000
# Opcional: query SQL personalizada que debe devolver una columna "signature"
DB_CHANGE_WATCH_QUERY=
